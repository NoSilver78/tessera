index 3444496..35f4bf3 100644
--- a/tests/test_ha_auth_contract.py
+++ b/tests/test_ha_auth_contract.py
@@ -113,3 +113,27 @@ def test_installed_permissions_accept_tesseras_allow_only_policy_shape() -> None
 
     assert permissions.check_entity("light.kitchen", "read") is True
     assert permissions.check_entity("light.hallway", "read") is False
+
+
+def test_installed_user_model_still_offers_the_permission_cache_drop() -> None:
+    """``User.invalidate_cache()`` must really drop the cached ``permissions``.
+
+    The adapters call it after every policy write and after a skipped bind. If
+    it stopped clearing the cache, a policy narrowed in place (an entity left a
+    granted area) would keep granting until Home Assistant restarts — the
+    behaviour, not just the name, is the contract.
+    """
+    from homeassistant.auth import models
+
+    user = models.User(name="contract", perm_lookup=None, groups=[], id="contract")
+
+    assert callable(getattr(user, "invalidate_cache", None))
+    _ = user.permissions
+    assert "permissions" in user.__dict__, "permissions is no longer cached"
+
+    user.invalidate_cache()
+
+    assert "permissions" not in user.__dict__, (
+        "invalidate_cache no longer drops the permissions cache — a policy "
+        "narrowed in place would keep granting until restart"
+    )
