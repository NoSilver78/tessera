diff --git a/tests/test_no_silent_ha_fallbacks.py b/tests/test_no_silent_ha_fallbacks.py
new file mode 100644
index 0000000..b100fad
--- /dev/null
+++ b/tests/test_no_silent_ha_fallbacks.py
@@ -0,0 +1,84 @@
+"""Guard against new *silent* fallbacks on Home Assistant internals.
+
+``getattr(obj, "attr", default)`` on a Home Assistant object hides a removed or
+renamed attribute behind the default. Where that default is permissive, the
+removal does not fail — it silently takes the less safe branch. That is how the
+owner/system-generated guards and the permissions-cache drop came to depend on
+HA internals without anything failing when they move.
+
+The rule: attributes of HA objects are read **strictly**, so a removal raises
+and the enforce path fails closed. A genuinely optional attribute — one that
+exists on some validated HA lines and not on others — is allowed, but it has to
+be listed here with its reason, so adding one is a decision instead of a habit.
+"""
+
+from __future__ import annotations
+
+import ast
+import pathlib
+
+COMPONENT = (
+    pathlib.Path(__file__).resolve().parent.parent / "custom_components" / "tessera"
+)
+
+# file name -> attribute name -> why this one may be read with a fallback
+ALLOWED: dict[str, dict[str, str]] = {
+    "resolver.py": {
+        "child_devices": "HA 2026.9+ only; absent on the validated 2026.7/2026.8 lines",
+    },
+    "d9_gate.py": {
+        "version": "custom-component manifests may legitimately carry no version",
+    },
+    # These three read the id with a fallback and then *validate* it: a missing
+    # id raises (UnsafeAuthTarget) or skips the user. The fallback is not a
+    # permissive branch, it is the input to an explicit check.
+    "__init__.py": {"id": "validated right after the read; missing id is rejected"},
+    "auth_adapter.py": {"id": "validated right after the read; missing id raises"},
+    "mode_manager.py": {"id": "validated right after the read; missing id is skipped"},
+}
+
+
+def _getattr_sites() -> list[tuple[str, str, int]]:
+    """Return (file, attribute, line) for every three-argument getattr call."""
+    sites: list[tuple[str, str, int]] = []
+    for path in sorted(COMPONENT.glob("*.py")):
+        tree = ast.parse(path.read_text(), filename=str(path))
+        for node in ast.walk(tree):
+            if (
+                isinstance(node, ast.Call)
+                and isinstance(node.func, ast.Name)
+                and node.func.id == "getattr"
+                and len(node.args) == 3
+                and isinstance(node.args[1], ast.Constant)
+                and isinstance(node.args[1].value, str)
+            ):
+                sites.append((path.name, node.args[1].value, node.lineno))
+    return sites
+
+
+def test_no_unlisted_silent_fallback_on_ha_attributes() -> None:
+    """Every fallback read of an HA attribute is listed with a reason."""
+    unlisted = [
+        f"{file}:{line} getattr(..., {attr!r}, <default>)"
+        for file, attr, line in _getattr_sites()
+        if attr not in ALLOWED.get(file, {})
+    ]
+
+    assert not unlisted, (
+        "Silent fallback on a Home Assistant attribute. Read it strictly so a "
+        "removal fails closed, or add it to ALLOWED in this test with the HA "
+        "lines that make it optional:\n  " + "\n  ".join(unlisted)
+    )
+
+
+def test_allowlist_has_no_stale_entries() -> None:
+    """An allowlist entry whose call site is gone must not linger."""
+    present = {(file, attr) for file, attr, _ in _getattr_sites()}
+    stale = [
+        f"{file}:{attr}"
+        for file, attrs in ALLOWED.items()
+        for attr in attrs
+        if (file, attr) not in present
+    ]
+
+    assert not stale, f"stale ALLOWED entries: {stale}"
