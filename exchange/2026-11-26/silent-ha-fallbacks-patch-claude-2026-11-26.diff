+"""Type-level assertions about the Home Assistant internals Tessera reads.
+
+Tessera reads attributes of HA's ``auth.models.User`` that Home Assistant gives
+no stability guarantee for. Reading them through ``getattr(user, "x", default)``
+hid a removal behind a *permissive* default: a renamed ``is_owner`` would have
+made the owner look manageable. This module states the expectation instead, so
+``mypy --strict`` fails the moment the installed Home Assistant no longer
+satisfies it — per validated line in the CI contract matrix, and nightly against
+the coming line.
+
+Nothing here runs: the whole module body is ``TYPE_CHECKING`` only.
+"""
+
+from __future__ import annotations
+
+from typing import TYPE_CHECKING
+
+if TYPE_CHECKING:
+    from typing import Protocol
+
+    from homeassistant.auth import models
+    from homeassistant.auth.permissions.types import PolicyType
+
+    class _UserLike(Protocol):
+        """Exactly the ``User`` surface Tessera's adapters and guards read."""
+
+        id: str
+        is_owner: bool
+        is_active: bool
+        system_generated: bool
+
+        def invalidate_cache(self) -> None:
+            """Drop HA's cached ``permissions``/``is_admin``."""
+
+    class _GroupLike(Protocol):
+        """Exactly the ``Group`` surface the policy adapter writes."""
+
+        id: str
+        name: str | None
+        policy: PolicyType
+        system_generated: bool
+
+    def _assert_user_contract(user: models.User) -> _UserLike:
+        """Fail the type check if HA's ``User`` loses a member Tessera reads."""
+        return user
+
+    def _assert_group_contract(group: models.Group) -> _GroupLike:
+        """Fail the type check if HA's ``Group`` loses a member Tessera writes."""
+        return group
